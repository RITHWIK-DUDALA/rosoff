# ==============================================================================
# CDPR Platform Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Backend Server Configuration
CDPR_HOST=0.0.0.0
CDPR_PORT=8000
CDPR_LOG_LEVEL=INFO

# Default Operating Mode: SIMULATION | HARDWARE_DISABLED | HARDWARE
CDPR_DEFAULT_MODE=SIMULATION

# Canonical Robot Configuration File (relative path)
CDPR_CONFIG_PATH=config/robot_config.yaml

# micro-ROS Agent Transport Configuration
# On Ubuntu Linux: /dev/ttyUSB0 or /dev/ttyACM0
# On Windows: COM3 or COM4
MICROROS_TRANSPORT=serial
MICROROS_SERIAL_PORT=/dev/ttyUSB0
MICROROS_BAUDRATE=115200

# Alternative UDP Transport (if micro-ROS configured over Wi-Fi)
MICROROS_UDP_PORT=8888
MICROROS_UDP_IP=192.168.1.100

# Safe Torque Off / Safety Circuit Pin Assignments (if using hardware I/O)
# (Keep empty or unconfigured until verified against physical drive manual)
SAFETY_ESTOP_PIN=
SAFETY_FAULT_INPUT_PIN=
